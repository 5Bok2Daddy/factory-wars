// 팩토리 워즈 시뮬레이션 데이터 정의.
#pragma max_players 4

#define MAX_PLAYERS 4
#define RELATION_CELLS 16
#define MAX_PROPOSALS 12
#define MAX_MODULES 3
#define MAX_QUEUE 5
// 항목 34 전장의 안개: 96x96 칸(칸 크기 = 맵 긴 변 / 96, 360m 맵이면 3.75m), 칸마다 1비트.
#define FOG_BYTES 1152


enum Relation : Byte { Enemy, Allied, BreakPending }
// Hold: 위치 고수(쫓지 않음). Patrol: TargetPosition과 PatrolOrigin 사이를 공격 이동으로 오간다(항목 30).
enum UnitOrder : Byte { Stop, Move, AttackMove, AttackTarget, Hold, Patrol }
enum ActionKind : Byte { Propose, Accept, Reject, Break, Note, Build, Gather, Repair, Processor, Produce, Attack, Garrison, Upgrade, Research, Ultimate }
enum RejectReason : Byte { InsufficientResources, PopulationLimit, Cooldown, ModeDisabled, Invalid, BlockedLocation, Locked, Truce, TierLocked, SizeLimit, Busy, NoVision, NeedGarrison, NoSetup, Limit, Weather, Doctrine, Hostile, Closed }
enum WorkerTask : Byte { Idle, Gather, Deliver, Build, Repair, Salvage, Demolish, Pontoon, Station }
enum BotDifficulty : Byte { Easy, Normal }
enum ResourceKind : Byte { Iron, Wood }
enum CaptureKind : Byte { Comms, Relay, Radar, Fuel }
enum PauseReason : Byte { None, Outage }
// 항목 33 궁극 전력. 종류는 UltimateSpec.Kind, 단계는 PlayerState.UltimatePhase.
// 항목 34-B 보급품 사전 알람 단계: Zone(35초 전, 넓은 경고 원), Closing(10초 전, 좁은 원), Landed(착지, 신호탄), Captured(획득).
enum DropPhase : Byte { Zone, Closing, Landed, Captured }
enum UltimateKind : Byte { Carrier, StrategicMissile, AmphibiousAssault }
// Preparing: 전용 건물에서 준비 중. Ready: 발동 대기(미사일·상륙). Active: 전장에 있음(항모·상륙정). Cooldown: 재사용 대기.
enum UltimatePhase : Byte { None, Preparing, Ready, Active, Cooldown }
// 모든 플레이어에게 가는 알림의 뜻. Launched는 미사일 발사·상륙 출발(Position이 목표), Impact는 착탄(Value가 요격 단계), Lost는 항모 격추·상륙정 전멸.
enum UltimateStage : Byte { Started, Half, Ready, Cancelled, Launched, Impact, Landed, Lost }

struct ResourceCost {
    FP Iron;
    FP Wood;
    FP Steel;
    FP Power;
}

// 맵에 놓는 모양. Radius가 0보다 크면 원, 아니면 회전 사각형이다.
struct MapShape {
    FPVector3 Center;
    FP Radius;
    FP HalfLength;
    FP HalfWidth;
    FP Yaw;
}

struct PlayerState {
    asset_ref<FactionSpec> Faction;
    ResourceCost Stock;
    FP PowerCap;
    FP PowerRate;
    QBoolean Outage;
    FP OutageSeconds;
    Int32 OutageCount;
    FP PopulationUsed;
    FP PopulationCap;
    Int32 Team;
    Int32 ColorIndex;
    Int32 NextNoteFrame;
    QBoolean Active;
    QBoolean Defeated;
    QBoolean IsBot;
    BotDifficulty Difficulty;
    Int32 UnitsProduced;
    Int32 UnitsLost;
    Int32 BuildingsLost;
    ResourceCost Earned;
    Int32 NextBaseAlertFrame;
    Int32 Captures;
    Int32 CaptureFrames;
    Int32 CratesPicked;
    // 항목 34-B: 긴급 출격권(항공 작전 즉시 재정비용, 34-D 전까지는 쌓이기만 한다), 낙하 상자 획득·쟁탈 횟수.
    Int32 SortieTickets;
    Int32 DropCaptures;
    Int32 DropContests;
    // 항목 34-C 주둔 저격수 측정: 저격 처치(보병·공병), 교란 장치 설치·파괴, 탐지로 드러난 횟수.
    Int32 SnipeKillsInfantry;
    Int32 SnipeKillsEngineers;
    Int32 JammersPlaced;
    Int32 JammersDestroyed;
    Int32 Detections;
    // 항목 34-D 작전 측정: 출격·완료·격추.
    Int32 SortiesLaunched;
    Int32 SortiesCompleted;
    Int32 SortiesShotDown;
    // 항목 37: 전술 도크린(0 없음, 1 공군 타격 사령부, 2 그림자 특수전단, 3 기갑 요새화 군단)과 승급 수.
    Int32 Doctrine;
    QBoolean DoctrineLocked;
    Int32 Promotions;
    // 중앙 암시장: 다음 거래 가능 프레임, 거래 수.
    Int32 TradeReadyFrame;
    Int32 TradesMade;
    Int32 HighGroundShots;
    Int32 GarrisonEntries;
    // 항목 30 온라인: 연결이 끊긴 프레임(0이면 연결됨). 끊긴 동안은 봇이 대신 조종한다.
    Int32 DisconnectedFrame;
    // 기권(직접 또는 끊김 시간 초과). VictorySystem이 패배로 처리한다.
    QBoolean Forfeited;
    // 결과 화면 통계(항목 30): 내가 파괴한 적 유닛·건물.
    Int32 UnitsKilled;
    Int32 BuildingsDestroyed;
    // 항목 31 테크: 기지 단계(1~3). 완공된 사령부 중 가장 높은 등급.
    Int32 BaseTier;
    // 단계에 처음 도달한 프레임(0이면 아직). [n]은 n+1단계.
    array<Int32>[3] TierFrames;
    // 끝낸 연구 비트. 번호는 FactionSpec.Researches 순서다.
    Int32 ResearchDone;
    // 크기별 공격·방어 연구 단계. 번호는 UnitSize 값이다.
    array<Byte>[4] AttackLevels;
    array<Byte>[4] ArmorLevels;
    // 크기별 생산 수(측정용).
    array<Int32>[4] ProducedBySize;
    // 항목 32: 보병이 엄폐에 들어간 횟수(측정용), 레이더 접근 경고 간격.
    Int32 CoverEntries;
    Int32 NextRadarAlertFrame;
    // 항목 33 궁극 전력. Remaining은 준비 중이면 남은 준비 시간, 대기 중이면 남은 재사용 대기다. Total은 이번 준비의 전체 시간.
    UltimatePhase UltimatePhase;
    FP UltimateRemaining;
    FP UltimateTotal;
    ResourceCost UltimatePaid;
    entity_ref UltimateSite;
    QBoolean UltimateHalf;
    Int32 UltimateUses;
    // 측정용: 처음 준비 시작·완료·사용 프레임(0이면 아직), 요격당한 횟수, 격추·격침된 횟수, 준비 중 전용 건물을 잃은 횟수,
    // 궁극 전력으로 부순 핵심 건물 수와 잃은 핵심 건물 수("궁극으로 결판" 판정).
    Int32 UltimateStartFrame;
    Int32 UltimateReadyFrame;
    Int32 UltimateUseFrame;
    Int32 UltimateIntercepted;
    Int32 UltimateLost;
    Int32 UltimateSitesLost;
    Int32 UltimateCoreKills;
    Int32 CoreLost;
    // 항목 37 전술 깊이(측정용 + 상태): 잔해 회수, 다리 폭파·복구, 비상 프로토콜 사용 여부, 블랙박스 회수·영구 화력 중첩.
    Int32 WrecksSalvaged;
    Int32 BridgesDown;
    Int32 BridgesRepaired;
    QBoolean ProtocolUsed;
    Int32 BlackBoxes;
    Int32 BlackBoxStacks;
}

struct BotState {
    FPVector3 Home;
    Int32 NextThinkFrame;
    Int32 NextAttackFrame;
    Int32 NextProposalFrame;
    Int32 NextNoteFrame;
    Int32 WaveSize;
    FPVector3 LanePoint;
    FPVector3 LaneTarget;
    Int32 LaneUntilFrame;
    Int32 CenterWaves;
    Int32 SideWaves;
    entity_ref LaneBarricade;
    entity_ref CrateRunner;
    Int32 NextSquadFrame;
    Int32 NextHighGroundFrame;
    Int32 RespondedDropFrame;
    Int32 NextGarrisonFrame;
    Int32 NextToppleFrame;
    // 항목 33: 상대의 궁극 준비 알림을 받은 프레임과 그 전용 건물(공격 목표), 내 궁극을 쏠 수 있게 된 뒤 다음 판단 프레임.
    Int32 ThreatFrame;
    entity_ref ThreatSite;
    player_ref ThreatOwner;
    Int32 NextUltimateFrame;
    Int32 ReadySinceFrame;
    // 모든 생산 대기열이 비기 시작한 프레임(0이면 생산 중).
    Int32 IdleSinceFrame;
}

struct ProductionOrder {
    asset_ref<UnitSpec> Unit;
    ResourceCost PaidCost;
}

struct AllianceProposal {
    player_ref From;
    player_ref To;
    Int32 ExpireFrame;
}

global {
    array<PlayerState>[MAX_PLAYERS] Players;
    array<BotState>[MAX_PLAYERS] Bots;
    QBoolean GameEnded;
    Int32 EndFrame;
    Int32 WinnerMask;
    Int32 TruceEndFrame;
    QBoolean BarrierOpen;
    Int32 NextDropFrame;
    Int32 DropGroup;
    QBoolean DropAnnounced;
    // 항목 37: 지금 기상 중인지(맵 데이터의 프레임 스케줄로 TacticalSystem이 갱신).
    QBoolean WeatherOn;
    // 항목 34-B: 0 = 경고 전, 1 = 구역 공개됨, 2 = 좁혀짐.
    Int32 DropStage;
    // 도시 건물 붕괴 비트. 번호는 MapSpec.CityBuildings의 순서다.
    array<Int32>[8] CityCollapsed;
    // 항목 32: 맵 엄폐점(바리케이드·도시 건물)을 만들었는지.
    QBoolean CoverReady;
    // 항목 37 블랙박스: 다음 추락 프레임과 지금까지 떨어진 횟수(맵의 순환 자리 선택용).
    Int32 NextBlackBoxFrame;
    Int32 BlackBoxCount;
}

component Unit {
    player_ref Owner;
    asset_ref<UnitSpec> Spec;
    FP Health;
    UnitOrder Order;
    FPVector3 TargetPosition;
    entity_ref TargetEntity;
    FP AttackCooldown;
    FP ReactiveArmorCooldown;
    array<asset_ref<ModuleSpec>>[MAX_MODULES] Modules;
    FP AbilityCooldown;
    Int32 EngagedUntilFrame;
    Int32 DesignatedUntilFrame;
    player_ref DesignatedBy;
    FP DesignatedBonus;
    Int32 SlideTurn;
    Int32 SlideFace;
    Int32 SlideUntilFrame;
    Int32 LastFiredFrame;
    Int32 ReservedUntilFrame;
    QBoolean Swarming;
    // 들어가 있는 진지 건물. 안에서는 NavMesh 에이전트가 없다.
    entity_ref Garrison;
    // 들어가려고 걸어가는 진지 건물.
    entity_ref GarrisonTarget;
    // 순찰 출발점(항목 30).
    FPVector3 PatrolOrigin;
    // 항목 32 엄폐: 잡은 엄폐점과 도착 여부.
    entity_ref Cover;
    QBoolean InCover;
    // 항목 33 상륙 강습: 이 프레임까지 공격력 보너스.
    Int32 AssaultUntilFrame;
    // 항목 34-C 주둔 저격수: 이 프레임부터 사격 가능(올라가기+자리 잡기), 은신 끝·다음 은신 가능 프레임, 사격 노출 끝 프레임과 피격 진영 비트, 탐지한 진영 비트.
    Int32 SetupUntilFrame;
    Int32 StealthUntilFrame;
    Int32 StealthReadyFrame;
    Int32 MuzzleRevealUntilFrame;
    Int32 MuzzleVictimMask;
    Int32 DetectedMask;
    // 교란 장치 설치 중: 끝나는 프레임과 대상 자원 노드.
    Int32 JammerUntilFrame;
    entity_ref JammerNode;
    // 항목 37 베테랑: 킬 수, 계급(0~3), 마지막으로 맞은 프레임(자가 회복 대기).
    Int32 Kills;
    Int32 VetRank;
    Int32 LastDamagedFrame;
    // 플레이어 조종 수송 탑승: 탑승 중인 수송 유닛, 탑승하러 접근 중인 수송 유닛, 후면 램프 열림 유지 프레임.
    entity_ref Transport;
    entity_ref BoardTarget;
    Int32 RampOpenUntilFrame;
}

// 항목 34-C 채굴 교란 장치. 은신 저격수가 적 자원 노드 곁에 둔다. 노드 채집 속도가 줄고, 탐지된 쪽에게만 보인다. DetectedMask는 탐지한 진영 비트.
component Jammer {
    player_ref Owner;
    entity_ref Node;
    FP Health;
    FP GatherMultiplier;
    Int32 UntilFrame;
    Int32 DetectedMask;
}

// 항목 34-D 비조작 작전기. 출격 때 점 6개(비행장·진입·목표·이탈·선회·비행장)와 누적 길이를 저장하고, 위치는 경과 프레임 × 속도로 구간 누적 거리를 따라 계산한다.
component Sortie {
    player_ref Owner;
    asset_ref<UnitSpec> Spec;
    entity_ref Airfield;
    Int32 Slot;
    Int32 StartFrame;
    FP Speed;
    FP Health;
    FPVector3 Target;
    FPVector2 Heading;
    array<FPVector3>[6] Points;
    array<FP>[6] Cum;
    Int32 NextEvent;
    QBoolean Dropped;
}

// 중앙 철조망 암시장(NPC 무기상). HostileMask는 영구 적대가 된 플레이어 비트. 파괴되면 모두에게 닫힌다.
component NpcTrader {
    FP Health;
    FP MaxHealth;
    Int32 HostileMask;
    QBoolean Destroyed;
    FP Cooldown;
    entity_ref Target;
    player_ref Killer;
}

// 항목 33 공중 항모. Docked는 격납 중인 드론 수, BuildProgress는 잃은 드론 재생산 진행(초), Assembling=true면 비행장 패드 지상 조립 중(지상 공격 가능).
component Carrier {
    Int32 Docked;
    FP BuildProgress;
    FP LaunchCooldown;
    Int32 LastContactFrame;
    entity_ref Target;
    QBoolean Assembling;
    entity_ref Site;
}

// 전략 미사일 착탄 후 15초간 남는 초토화·방사능 구역(지속 피해 + 이동 속도 저하).
component ScorchedZone {
    player_ref Owner;
    FPVector3 Position;
    FP Radius;
    FP DamagePerSecond;
    FP SlowMultiplier;
    Int32 StartFrame;
    Int32 UntilFrame;
}

// 항모 드론. 항모가 사라지면 함께 추락한다. 플레이어 명령을 받지 않는다.
component Drone {
    entity_ref Carrier;
}

// 날아오는 전략 미사일. Origin에서 Target으로 포물선 비행하며 Health(300)를 가진다. 패트리어트 요격으로 체력이 0이 되면 공중 폭발한다.
component MissileStrike {
    player_ref Owner;
    asset_ref<UltimateSpec> Spec;
    FPVector3 Origin;
    FPVector3 Target;
    FPVector3 CurrentPosition;
    FP Health;
    FP MaxHealth;
    Int32 LaunchFrame;
    Int32 ImpactFrame;
}

// 상륙정. Stage 0 접근, 1 하선 후 포격 지원, 2 귀환. 하선 전에 격침되면 탑재 부대도 잃는다. 플레이어 명령을 받지 않는다.
component LandingCraft {
    Int32 Stage;
    Int32 Index;
    FPVector3 Shore;
    FPVector3 Water;
    FPVector3 Goal;
    FPVector3 Home;
    Int32 UntilFrame;
}

// 항목 32: 보병 엄폐점. Facing은 막아 주는 방향(그쪽에서 오는 사격을 줄인다). Source가 사라지면 점도 사라진다.
component CoverSpot {
    FPVector3 Position;
    FPVector2 Facing;
    FP Reduction;
    entity_ref Source;
    entity_ref Occupant;
}

component Worker {
    WorkerTask Task;
    entity_ref Target;
    ResourceKind CarriedKind;
    FP Carried;
    FP WorkTimer;
    Int32 NextPathFrame;
    Int32 Spot;
}

// 항목 34-D 비행장 격납 칸. State 0 빔, 1 대기(ReadyFrame부터 출격 가능), 2 출격 중.
struct HangarSlot {
    asset_ref<UnitSpec> Spec;
    Int32 State;
    Int32 ReadyFrame;
}

component AirfieldWorks {
    MapShape Site;
}

component Building {
    player_ref Owner;
    asset_ref<BuildingSpec> Spec;
    FP Health;
    FP ConstructionRemaining;
    array<ProductionOrder>[MAX_QUEUE] Queue;
    Int32 QueueCount;
    FP QueueProgress;
    array<asset_ref<ModuleSpec>>[MAX_MODULES] Preset;
    entity_ref TargetEntity;
    FP AttackCooldown;
    PauseReason Paused;
    QBoolean ProcessorOff;
    FP ProcessTimer;
    // 집결 지점(항목 30). 생산된 유닛이 이리로 이동한다.
    QBoolean HasRally;
    FPVector3 Rally;
    // 항목 31: 사령부 등급과 업그레이드(진행 중이면 UpgradeTier가 목표 등급). 업그레이드 중에도 생산은 한다.
    Int32 Tier;
    Int32 UpgradeTier;
    FP UpgradeRemaining;
    ResourceCost UpgradePaid;
    // 연구소의 진행 중 연구. FactionSpec.Researches 번호 + 1이다(0이면 없음).
    Int32 Research;
    FP ResearchRemaining;
    // 항목 32: 엄폐점을 만들었는지(모래주머니·벙커).
    QBoolean CoverMade;
    // 항목 34-D: 비행장 격납 칸 4개.
    array<HangarSlot>[4] Hangar;
    // 항목 37: 사령부 비상 방어 프로토콜(피해 감소·자동 사격이 끝나는 프레임, 다음 사격 프레임).
    Int32 ProtocolUntilFrame;
    Int32 ProtocolNextShotFrame;
    // 전략 미사일 EMP 충격파: 이 프레임까지 적 방어 포탑·생산 건물 작동 정지(5초).
    Int32 EmpUntilFrame;
    // 산업 공장 확장 레벨(0/1 = Lv.1, 2 = Lv.2 +25%, 3 = Lv.3 +50%).
    Int32 FactoryLevel;
    // 비상 과부하(Overdrive): 이 프레임까지 생산 속도 +50%, 전력 소비 2배, 초당 소량 과열 피해.
    Int32 OverdriveUntilFrame;
    Int32 OverdriveCooldownFrame;
    // 자원 노드 직결 채굴 공장(자동 제재소 · 광산 채굴 공장): 연결된 자원 노드와 주기적 자동 채굴 타이머.
    entity_ref ExtractNode;
    FP ExtractTimer;
}

// 항목 37: 기갑 잔해. 30초 동안 임시 엄폐점을 만들고 공병이 분해하면 고철(Scrap)을 준다.
component Wreck {
    Int32 UntilFrame;
    FP Scrap;
    FP Work;
    Int32 Size;
    asset_ref<UnitSpec> Spec;
}

// 항목 37: 교량 상태(체력·파괴·폰툰 복구 여부). Seat는 지키는 본진 자리.
component Bridge {
    Int32 Index;
    Int32 Seat;
    FP Health;
    FP MaxHealth;
    QBoolean Destroyed;
    QBoolean Pontoon;
    FP Work;
}

// 항목 37: 추락 수송기 블랙박스(점령형 목표). 한 쪽만 반경 안에 있으면 Progress가 오른다.
component BlackBox {
    Int32 UntilFrame;
    FP Progress;
    player_ref Claimant;
    QBoolean Contested;
}

component ResourceNode {
    ResourceKind Kind;
    FP Remaining;
    MapShape Shape;
}

// 공격 대상이 아니다. Claimant는 지금 진행도를 쌓는 쪽이다.
component CaptureSite {
    CaptureKind Kind;
    FP Radius;
    Int32 Index;
    player_ref Owner;
    player_ref Claimant;
    FP Progress;
    QBoolean Contested;
}

// 중립이다. 지정 공격과 범위 피해만 받는다.
component Barricade {
    Int32 Index;
    FP Health;
    MapShape Shape;
}

// 중립 도시 건물. 지정 공격과 범위 피해로만 깎인다. Stage는 0 멀쩡함, 1 금, 2 불, 3 붕괴다.
component CityBuilding {
    Int32 Index;
    FP Health;
    FP MaxHealth;
    Int32 Stage;
    player_ref Occupant;
}

// Seat가 0 이상이면 그 자리만 회수한다.
component SupplyCrate {
    Int32 Seat;
    ResourceCost Reward;
    // 항목 34-B: 낙하 상자(Seat < 0)는 3m 안에 5초 머물러야 얻는다. 적이 함께 있으면 진행이 멈춘다.
    FP Progress;
    QBoolean Contested;
}

// 항목 34: 플레이어마다 지금 보이는 칸(Visible)과 본 적 있는 칸(Explored). 5틱마다 FogSystem이 다시 만든다.
struct FogGrid {
    array<Byte>[FOG_BYTES] Visible;
    array<Byte>[FOG_BYTES] Explored;
}

singleton component Fog {
    array<FogGrid>[MAX_PLAYERS] Grids;
    // 항목 34-B: 보급 신호탄(모든 플레이어에게 보이는 자리·끝나는 프레임)과 정찰 사진(플레이어별 한 곳).
    array<FPVector3>[MAX_PLAYERS] FlarePositions;
    Int32 FlareCount;
    Int32 FlareUntilFrame;
    array<FPVector3>[MAX_PLAYERS] ReconPositions;
    array<Int32>[MAX_PLAYERS] ReconUntilFrames;
    FP Cell;
    FP MinX;
    FP MinZ;
    Int32 NextUpdateFrame;
    // 화면이 안개 텍스처를 다시 올릴지 아는 번호(갱신마다 1 증가).
    Int32 Revision;
}

singleton component Diplomacy {
    array<Relation>[RELATION_CELLS] Relations;
    array<AllianceProposal>[MAX_PROPOSALS] Proposals;
    array<Int32>[RELATION_CELLS] BreakExpireFrames;
    array<Int32>[RELATION_CELLS] RealliableFrames;
    // 칸 [a][b]는 a가 b를 보는 점수다. AI 판단에만 쓴다.
    array<Int32>[RELATION_CELLS] Opinions;
    // 칸 [a][b]는 a가 b를 마지막으로 때린 프레임이다.
    array<Int32>[RELATION_CELLS] LastAttackFrames;
    // 칸 [a][b]는 동맹 a·b의 공동의 적이 사라진 프레임이다. 0이면 공동의 적이 있다.
    array<Int32>[RELATION_CELLS] NoEnemyFrames;
    Int32 NextOpinionFrame;
    QBoolean JointVictory;
    QBoolean TeamMode;
    Int32 JointVictoryFrame;
}

// 경기 결과에 영향을 주는 알림은 롤백으로 취소되지 않도록 검증된 프레임에서만 보낸다.
// Missing은 MissingResource 비트의 합이다. 모자란 자원 전부를 담는다.
synced event ActionRejected { player_ref Player; ActionKind Kind; RejectReason Reason; Int32 Missing; }
synced event NoteReceived { player_ref Sender; player_ref Receiver; Int32 PhraseId; }
synced event AllianceChanged { player_ref A; player_ref B; Relation Relation; }
event UnitDestroyed { entity_ref Unit; player_ref Owner; asset_ref<UnitSpec> Spec; }
synced event PlayerDefeated { player_ref Player; }
synced event PlayerConnection { player_ref Player; QBoolean Connected; }
synced event BarrierOpened { Int32 Frame; }
synced event CaptureStarted { entity_ref Site; player_ref Player; }
synced event CaptureContested { entity_ref Site; }
synced event CaptureChanged { entity_ref Site; player_ref Previous; player_ref Next; }
synced event BarricadeDestroyed { Int32 Index; }
synced event SupplyDropIncoming { Int32 Group; Int32 Frame; }
// 항목 34-B: 단계별 공개. Zone·Closing은 정확한 자리가 아니라 원의 중심과 반지름이다. Landed부터 상자 자리가 드러난다. Kind는 Captured일 때 보상 종류(0 자원, 1 긴급 출격권, 2 정찰 사진, 3 보급).
synced event SupplyDropStage { DropPhase Phase; FPVector3 Position; FP Radius; Int32 Frame; Int32 Group; player_ref Player; Int32 Kind; }
synced event CratePicked { player_ref Player; FPVector3 Position; ResourceCost Reward; }
// 항목 34-C: 저격수가 쏜 사격. 피격 진영에 방향을 알리고 총구 섬광을 그린다.
synced event SniperFired { player_ref Shooter; player_ref Victim; FPVector3 From; FPVector3 To; QBoolean Killed; }
synced event JammerPlaced { player_ref Owner; entity_ref Jammer; FPVector3 Position; }
synced event JammerRemoved { player_ref Owner; FPVector3 Position; QBoolean Destroyed; }
// 항목 34-D: 작전기 출격(Kind는 SortieKind)과 종료(격추 여부).
synced event SortieLaunched { player_ref Player; entity_ref Sortie; Int32 Kind; FPVector3 Target; }
synced event SortieEnded { player_ref Player; QBoolean ShotDown; FPVector3 Position; }
// 항목 37
synced event VeteranPromoted { player_ref Owner; Int32 Rank; }
synced event WeatherChanged { QBoolean On; }
synced event WreckLeft { entity_ref Wreck; FPVector3 Position; Int32 Size; }
synced event WreckSalvaged { player_ref Player; FPVector3 Position; FP Iron; }
synced event BridgeChanged { Int32 Index; QBoolean Destroyed; player_ref By; }
synced event HqProtocol { player_ref Player; entity_ref Building; FPVector3 Position; }
event HqProtocolShot { FPVector3 From; FPVector3 To; }
synced event BlackBoxDown { entity_ref Box; FPVector3 Position; Int32 Seconds; }
synced event BlackBoxEnded { FPVector3 Position; player_ref Winner; Int32 Reward; }
synced event DoctrineChosen { player_ref Player; Int32 Doctrine; QBoolean ByDefault; }
// 중앙 암시장
synced event TraderHostile { player_ref Player; }
synced event TraderDestroyed { player_ref Killer; ResourceCost Bounty; }
synced event TraderTrade { player_ref Player; Int32 Offer; }
synced event TraderShot { FPVector3 From; FPVector3 To; }
synced event BaseUnderAttack { player_ref Player; FPVector3 Position; }
synced event CityBuildingDamaged { entity_ref Building; Int32 Index; Int32 Stage; }
synced event CityBuildingCollapsed { Int32 Index; }
synced event CityBuildingToppled { Int32 Index; }
synced event GarrisonChanged { entity_ref Building; player_ref Occupant; Int32 Count; }
synced event PowerOutage { player_ref Player; QBoolean Started; }
synced event BuildingPaused { entity_ref Building; PauseReason Reason; }
synced event GameOver { Int32 WinnerMask; }
// 항목 31: 기지 단계가 바뀜(올라가거나 사령부를 잃어 내려감), 연구 완료.
synced event BaseTierChanged { player_ref Player; Int32 Tier; }
synced event ResearchCompleted { player_ref Player; Int32 Index; }
// 항목 32: 레이더 범위에 적이 들어옴.
synced event RadarContact { player_ref Player; FPVector3 Position; }
// 항목 33 궁극 전력 알림. 모든 플레이어가 받는다. Position은 전용 건물(준비)·목표(발사·착탄·상륙)·격추 자리, Value는 남은 초(Started·Half·Launched) 또는 요격 단계(Impact, -1=공중 완전 요격).
synced event UltimateNotice { player_ref Player; UltimateStage Stage; UltimateKind Kind; FPVector3 Position; Int32 Value; }
synced event MissileBackblast { FPVector3 Position; FP Radius; }
event MissileInterceptShot { FPVector3 From; FPVector3 To; QBoolean Killed; }
synced event DepotExploded { FPVector3 Position; FP Radius; }
synced event TransportRamp { entity_ref Transport; QBoolean Unload; }
synced event ExtractorStaffChanged { entity_ref Building; Int32 Count; }
// 항목 27: 범위 피해가 난 자리(포격·폭격·폭발). 화면 손상 지도·크레이터용.
synced event AreaImpact { FPVector3 Position; FP Radius; }
// 항목 27: 유닛·건물이 부서진 자리. Size는 유닛이면 UnitSize 값, 건물이면 -1이고 Footprint가 반지름이다.
synced event Wrecked { FPVector3 Position; Int32 Size; FP Footprint; }
